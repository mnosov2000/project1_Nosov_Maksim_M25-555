[0.412537, "o", "\u001b[?2004h\u001b[0;32m@mnosov2000 \u001b[0m➜ \u001b[1;34m/workspaces/project1_Nosov_Maksim_M25-555 \u001b[0;36m(\u001b[1;31mmain\u001b[0;36m) \u001b[0m$ "]
[8.551587, "o", "\u001b[7mmake project\u001b[27m"]
[9.016236, "o", "\b\b\b\b\b\b\b\b\b\b\b\bmake project\r\n\u001b[?2004l\r"]
[9.018834, "o", "poetry run project"]
[9.019388, "o", "\r\n"]
[9.662284, "o", "Добро пожаловать в Лабиринт сокровищ!\r\n\r\n== ENTRANCE ==\r\nВы в темном входе лабиринта. Стены покрыты мхом. На полу лежит старый факел.\r\nЗаметные предметы: torch\r\nВыходы: north, east\r\n> "]
[16.397973, "o", "take torch"]
[16.865836, "o", "\r\n"]
[16.866012, "o", "Вы подняли: torch\r\n> "]
[20.420861, "o", "go north"]
[21.327579, "o", "\r\n\r\n== HALL ==\r\n"]
[21.327941, "o", "Большой зал с эхом. По центру стоит пьедестал с запечатанным сундуком.\r\nВыходы: south, west, north\r\nКажется, здесь есть загадка (используйте команду solve).\r\n> "]
[25.014425, "o", "go west"]
[25.385838, "o", "\r\n"]
[25.386199, "o", "\r\n== LIBRARY ==\r\nПыльная библиотека. На полках старые свитки. Где-то здесь может быть ключ от сокровищницы.\r\nЗаметные предметы: ancient_book\r\nВыходы: east, north\r\nКажется, здесь есть загадка (используйте команду solve).\r\n\r\n[Случайное событие] Вы слышите странный шорох за спиной...\r\nУ вас нет оружия, становится жутко.\r\n> "]
[29.122052, "o", "solve"]
[29.884477, "o", "\r\n"]
[29.884728, "o", "В одном свитке загадка: \"Что растет, когда его съедают?\" (ответ одно слово)\r\nВаш ответ: "]
[37.015756, "o", "р"]
[37.313888, "o", "е"]
[37.869612, "o", "з"]
[38.150474, "o", "о"]
[38.367406, "o", "н"]
[38.510345, "o", "а"]
[38.608943, "o", "н"]
[38.731366, "o", "с"]
[39.643163, "o", "\r\n"]
[39.643387, "o", "Верно! Вы разгадали загадку.\r\nВы чувствуете, что стали мудрее.\r\n> "]
[42.724792, "o", "go north"]
[43.078683, "o", "\r\n"]
[43.078903, "o", "\r\n== ARMORY ==\r\nСтарая оружейная комната. На стене висит меч, рядом — небольшая бронзовая шкатулка.\r\n"]
[43.079112, "o", "Заметные предметы: sword, bronze_box\r\nВыходы: south\r\n> "]
[47.608092, "o", "take sword"]
[48.091511, "o", "\r\nВы подняли: sword\r\n> "]
[50.661054, "o", "take bronze_box"]
[50.904612, "o", "\r\n"]
[50.905615, "o", "Вы подняли: bronze_box"]
[50.905816, "o", "\r\n> "]
[53.866104, "o", "use bronze_box"]
[54.38377, "o", "\r\n"]
[54.384479, "o", "Вы открыли шкатулку.\r\nВнутри лежал ржавый ключ! (rusty_key добавлен в инвентарь)\r\n> "]
[58.453435, "o", "go south"]
[58.951587, "o", "\r\n\r\n== LIBRARY ==\r\nПыльная библиотека. На полках старые свитки. Где-то здесь может быть ключ от сокровищницы.\r\nЗаметные предметы: ancient_book\r\nВыходы: east, north\r\n"]
[58.95181, "o", "> "]
[63.015579, "o", "go east"]
[63.425221, "o", "\r\n\r\n== HALL ==\r\nБольшой зал с эхом. По центру стоит пьедестал с запечатанным сундуком.\r\nВыходы: south, west, north\r\nКажется, здесь есть загадка (используйте команду solve).\r\n> "]
[67.604067, "o", "go north"]
[68.224073, "o", "\r\n"]
[68.224336, "o", "Вы используете найденный ключ, чтобы открыть путь в комнату сокровищ.\r\n\r\n== TREASURE_ROOM ==\r\nКомната, на столе большой сундук. Дверь заперта — нужен особый ключ.\r\nЗаметные предметы: treasure_chest\r\n"]
[68.22437, "o", "Выходы: south\r\n"]
[68.224491, "o", "Кажется, здесь есть загадка (используйте команду solve).\r\n> "]
[77.389728, "o", "solve"]
[78.080985, "o", "\r\n"]
[78.081249, "o", "Сундук заперт.\r\n"]
[78.081297, "o", "Ввести код? (да/нет): "]
[80.440077, "o", "д"]
[80.604316, "o", "а"]
[81.35709, "o", "\r\n"]
[81.357157, "o", "Введите код: "]
[82.116131, "o", "1"]
[82.303766, "o", "0"]
[84.464306, "o", "\r\nМеханизм щелкнул! Вы подобрали код."]
[84.464638, "o", "\r\nВ сундуке сокровище! Вы победили!"]
